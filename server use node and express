this is code of create server use node js and express this file called server.js

const express = require('express');

const app = express();
const PORT = 3000;

// Middleware to parse JSON
app.use(express.json());

// Basic route
app.get('/', (req, res) => {
    res.send('Hello, World!');
});

// Example API route
app.get('/api/users', (req, res) => {
    const users = [
        { id: 1, name: "Alice" },
        { id: 2, name: "Bob" }
    ];
    res.json(users);
});

// POST route example
app.post('/api/users', (req, res) => {
    const newUser = req.body;
    res.status(201).json({
        message: "User created successfully",
        user: newUser
    });
});

// Start server
app.listen(PORT, () => {
    console.log(`Server running on http://localhost:${PORT}`);
});
